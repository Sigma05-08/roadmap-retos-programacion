from colorama import Fore, Style, init
init()

#Mi diccionario
my_contac = {}
def my_diary():
    while True:
         print(f"{Fore.LIGHTRED_EX}---------------------------------------")
         print(f"{Fore.YELLOW}           Agenda de Contactos")
         print(f"{Fore.LIGHTRED_EX}---------------------------------------{Style.RESET_ALL}")
         print(my_contac)
         print(f"\n{Fore.RED}1 {Fore.YELLOW}-> Ingresar un contacto\n{Fore.RED}2 {Fore.YELLOW}-> Buscar un contacto\n{Fore.RED}3 {Fore.YELLOW}-> Editar contacto\n{Fore.RED}4 {Fore.YELLOW}-> Salir")
         operación = (input(f"{Fore.LIGHTRED_EX}Ingresa el númeral de tu operación: {Style.RESET_ALL} "))
         match operación:       
             case "1":
                   
                   new_contacto = input(f"{Fore.LIGHTRED_EX}Ingresa el nombre de tu contacto:{Style.RESET_ALL} ")
                   new_phone = input(f"{Fore.LIGHTRED_EX}Ingresa el número de tu contacto:{Style.RESET_ALL} ")
                   if len(new_phone) == 9 and new_phone.isdigit():
                     my_contac[new_contacto] = new_phone
                   else:
                     print(f"{Fore.LIGHTMAGENTA_EX}⚠️ Ingresa 9 números")  
             case "2":
                 contacto = input(f"{Fore.LIGHTRED_EX}Ingresa tu contacto que quieres buscar:{Style.RESET_ALL} ")
 
                 if contacto in my_contac:
                     print(f"{Fore.LIGHTMAGENTA_EX}el número de telefono de {contacto} es {my_contac[contacto]}")
                 else:
                     print(f"{Fore.LIGHTMAGENTA_EX}El contacto {contacto} no existe")
             case "3":
                 n_contacto = input(f"{Fore.LIGHTRED_EX}Ingresa el nombre del contacto que quieres editar:{Style.RESET_ALL} ")               
                 if n_contacto in my_contac:
                     new_phone = input(f"{Fore.LIGHTRED_EX}Ingrese el nuevo número del contacto: {Style.RESET_ALL} ")
                     print(f"{Fore.LIGHTMAGENTA_EX}el contacto a sido cambiado a este '{new_contacto}'")
                     my_contac[n_contacto] = new_phone
                 else:
                     print("{Fore.LIGHTMAGENTA_EX}El número de telefono del contacto no existe")
             case "4":
                print(f"{Fore.LIGHTMAGENTA_EX}Gracias por haber usado nuestra agenda de contactos ✨")
                break
             case _:
                 print(f"{Fore.LIGHTMAGENTA_EX}Ingrese un numeral válido")

    

my_diary()
