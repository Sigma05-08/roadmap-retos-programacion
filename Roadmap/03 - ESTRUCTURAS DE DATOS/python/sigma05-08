#LISTAS
#- Ordenadas -Iteradas
# -Admite elementos duplicados

my_list = ["pollo a la luz", "Seco de pollo", "Lentejas", "Trigo"]
print(my_list[0]) #acceso
print(my_list)
my_list.append("Arroz Chaufa") #insersión
print(my_list)
my_list.remove("Arroz Chaufa") #eliminación
my_list[1] = "Pizza"
print(my_list)
my_list.sort() #Ordenación
print(my_list)
#TUPLAS
#-Ordenadas -Admite duplicados
#Iterados

my_tuple = ("Scarlett","Javier", "15", "Karate")
print(my_tuple)
print(my_tuple[1]) #acceso
my_tuple = sorted(my_tuple) #cambiar a lista
print(my_tuple)
print(type(my_tuple))
my_tuple = tuple(sorted(my_tuple)) #devolver a tupla
print(my_tuple)
print(type(my_tuple))

#SETS/CONJUNTOS: 
#- No se puede ordenar
# -Perfecto para guardar infinidades de datos
# -No admite elementos duplicados
my_set = {"Scareltt", "15","karate", "Angelo"}
print(type(my_set))
my_set.add("Saco Oliveros") #inserción
my_set.add("Saco Oliveros")
print(my_set)
my_set.remove("Saco Oliveros") #eliminación
print(my_set)
my_set = sorted(my_set) #transformarlo a lista
print(my_set)
print(type(my_set))
my_set = set(sorted(my_set)) #transformarlo a set
print(type(my_set))

