#operadores Aritmeticos
print(f"suma: 5 + 7 = {5 + 7}")
print(f"producto: 5 * 7 = {5*7}")
print(f"resta: 7 - 5 = {7 - 5}")
print(f"división: 7/5 = {7/5}")
print(f"modulo: 7 % 5 = {7 % 5}")
print(f"exponente: 7 ** 2 = {7 ** 2}")
print(f"División entera: 7//3 = {7//3}")
#Operadores de comaparación
print(f"Igualdad: 10 == 3 es {10 == 3}")
print(f"Desigualdad: 10!=3 es {10 != 3}")
print(f"Mayor que: 10 > 3 es {10 > 3}")
print(f"Menor que: 10 < 3 es {10 < 3}")
print(f"Mayor o igual que: 10 >= 3 es {10 >= 3}")
print(f"Menor o igual que: 10 <= 3 es {10 <= 3}")
#Operadores lógicos
print(f" AND &&: 10 + 3 = 13 and 5 - 3 = 2 es {10 + 3 == 13 and 5 - 3 == 2}")
print(f"OR ||: 5 + 2 = 7 or 6 - 4 = 3 es {5 + 2 == 7 or 6 - 4 == 3}")
print(f" NOT: not 10 + 4 == 12 es {not 10 + 4 == 12}")
#operadores de asignación 
my_number = 30
my_number += 1 #suma y asigación
