print(my_number)
my_number /= 5  #división y asignación
print(my_number)
my_number *= 3  #multiplicación y asignación
print(my_number)
my_number %= 5 #modulo y asignación
print(my_number)
my_number **= 2 #exponente y asignación
print(my_number)
my_number //= 4 #división entera y asignación
print(my_number)
#operadores de identidad
my_number2 = 2.0
print(f"my_number is my_number2 es {my_number is my_number2}")
my_number = my_number2
print(f"my_number is my_number2 es {my_number is my_number2}")
